<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ME7Visual.Output (legacy name: VisualME7Logger.Output)
    SDK-style csproj on .NET 8.

    Hand-written during Phase 1b after the dotnet/try-convert tool failed
    to load against the .NET 8 SDK (System.Runtime 8.0.0.0 binding error,
    see https://github.com/dotnet/docs/issues/36659).

    Implicit-globbed by Microsoft.NET.Sdk:
      - Compile           : **/*.cs
      - EmbeddedResource  : **/*.resx
      - None              : everything else under the project (settings, configs, resources)
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VisualME7Logger.Output</RootNamespace>
    <AssemblyName>VisualME7Logger.Output</AssemblyName>
    <!-- Keep the legacy Properties/AssemblyInfo.cs as the source of truth
         (set false to avoid the SDK auto-generating duplicate attributes). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modern, maintained sync fork of NCalc. Replaces the file-referenced
         legacy NCalc.dll v1.3.8 (which transitively depended on Antlr3.Runtime).
         Pin to a concrete version after first restore: dotnet list package -->
    <PackageReference Include="NCalcSync" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native ME7Logger sidecar files (binaries, ECU defs, sample logs/configs)
         copied to output so RealTime mode can spawn ME7Logger.exe and so the
         golden-file CSVs are available for LogFile-mode replay tests. -->
    <None Update="resources\ME7Logger\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- Exclude the legacy file-referenced DLLs from being treated as project
         items. NCalcSync NuGet replaces NCalc.dll; Antlr3.Runtime.dll is no
         longer needed. Both files can be deleted from disk after first
         successful build (kept on disk for now to reduce churn in this commit). -->
    <None Remove="resources\NCalc.dll" />
    <None Remove="resources\Antlr3.Runtime.dll" />
  </ItemGroup>

</Project>
